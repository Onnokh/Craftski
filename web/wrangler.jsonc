// The website: site/ as static assets and worker/ serving TSM's price files at /prices/*, at
// craftski.onkie.dev. Deploy with `npm run deploy` from web/.
{
  "name": "craftski",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-06",
  // Static files win; /prices/* has no files, so the Worker answers it.
  "assets": { "directory": "./site", "binding": "ASSETS" },
  "routes": [{ "pattern": "craftski.onkie.dev", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  // Fill the id from `wrangler kv namespace create PRICES` before the first deploy.
  "kv_namespaces": [{ "binding": "PRICES", "id": "<filled at deploy>" }]
}
