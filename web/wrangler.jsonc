// The website: site/ as static assets and worker/ serving TSM's price files at /prices/* and game
// data at /data/*, at craftski.onkie.dev. Deploy with `npm run deploy` from web/.
{
  "name": "craftski",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-06",
  // Static files win; /prices/* and /data/* have no files, so the Worker answers them.
  "assets": { "directory": "./site", "binding": "ASSETS" },
  "routes": [{ "pattern": "craftski.onkie.dev", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "kv_namespaces": [{ "binding": "PRICES", "id": "8b5514d693ee44e597f2cea7f234b1ba" }]
}
